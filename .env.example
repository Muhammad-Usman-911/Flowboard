# Copy to .env and adjust. Docker Compose and the backend both read these values.
# NEVER commit your real .env file.

# --- host ports used by docker compose ---
WEB_PORT=5183
API_PORT=8103
DB_PORT=55433
REDIS_PORT=56379

# --- database (compose builds DATABASE_URL from these) ---
POSTGRES_USER=flowboard
POSTGRES_PASSWORD=flowboard
POSTGRES_DB=flowboard

# --- backend settings (backend/app/core/config.py) ---
# When running the API outside Docker, these are read from backend/.env:
DATABASE_URL=postgresql+asyncpg://flowboard:flowboard@localhost:55433/flowboard
REDIS_URL=redis://localhost:56379/0
# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
CORS_ORIGINS=http://localhost:5183,http://127.0.0.1:5183
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=INFO
LOG_JSON=true
ENVIRONMENT=development

# Load the demo workspace + users on API start (compose only). Safe to leave on.
SEED_DEMO_DATA=true
